# ---------------------------------------------------------------------------
# Capturas de trafico. NO se publican: llevan el nombre de cuenta del jugador,
# el chat publico de OTRAS personas del servidor donde se grabaron, y la IP de
# ese servidor. El analisis de esas capturas esta en docs/; los bytes crudos
# no hacen falta para nada.
# ---------------------------------------------------------------------------
logs/
*.pcapng
*.pcap

# Corpus derivado de las capturas y del cliente (544 MB). Se regenera con
# tools/build_corpus2.py y tools/extract_content.py a partir de los paks.
corpus/

# El cliente descompilado (17 MB). Es material con copyright de IGG: se usa
# como referencia para entender el protocolo, pero no se redistribuye.
Angel_unpacked.c
*.exe
*.dll

# Cuentas y personajes: datos locales de cada quien, con contrasenas.
data/cuentas.json

# Codigo heredado de un proyecto anterior, que solo se consulto.
src/

# Restos de Windows y del editor
nul
__pycache__/
*.pyc
.vscode/
.idea/
Thumbs.db
desktop.ini
